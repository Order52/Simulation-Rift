<?xml version="1.0" encoding="utf-8"?>
<!-- Cleartext is permitted only because users may browse http: sites, which
     the browser marks as not encrypted (§10.2). Every connection the engine
     makes goes to the controller's egress proxy on loopback (§8.8), which
     enforces the destination rules (INV-13, INV-14). No user-installed CAs
     are trusted. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
