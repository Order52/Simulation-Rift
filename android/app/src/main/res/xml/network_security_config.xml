<?xml version="1.0" encoding="utf-8"?>
<!-- The controller has no web engine: its transfers and the egress proxy
     run in rift-core, which applies its own rules (INV-13, INV-14). This
     file governs only the platform HTTP stack, which the debug tests use to
     read the fixture server on localhost. No user-installed CAs are trusted. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
