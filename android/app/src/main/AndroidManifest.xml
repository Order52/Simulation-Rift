<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- For rift-core's own transfers and the egress proxy (§8.2). Camera,
         microphone, location, storage and the rest are absent from both
         apps, so the OS denies them whatever a page asks. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Lets each window hide other apps' overlays while it is shown
         (WindowGuard, API 31+). A normal permission. -->
    <uses-permission android:name="android.permission.HIDE_OVERLAY_WINDOWS" />

    <!-- Shizuku's library also requests moe.shizuku.manager.permission.API_V23:
         Shizuku sends its binder only to apps that request it (§8.9). It is
         Shizuku's own permission, granted only through Shizuku's prompt, and
         gives no access to the device; without Shizuku it does not exist. -->

    <!-- Installs the sealed browser Rift carries, after the user allows it and
         confirms Android's install screen (§8.10). -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- The browser app must be visible to bind and start it (API 30). -->
    <queries>
        <package android:name="org.simulationrift.browser" />
        <!-- §8.12: the relay app, to pin its certificate and ask it to start. -->
        <package android:name="org.torproject.android" />
    </queries>

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:icon="@mipmap/rift_icon"
        android:roundIcon="@mipmap/rift_icon"
        android:theme="@style/Theme.Rift"
        android:zygotePreloadName=".PreviewZygotePreload">

        <!-- Trusted controller: UI, rift-core, sessions. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Rift appears as a browser choice; the link is checked before loading. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="http" />
                <data android:scheme="https" />
            </intent-filter>
            <!-- Files another app opens with Rift go into the session's
                 quarantine, to be scanned and viewed in isolated workers
                 (§11.1). Rift opens the types it can show. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:mimeType="image/*" />
                <data android:mimeType="application/pdf" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- The one share target: a shared link is checked and the verdict
             shown over the sharing app; any shared file is passed to the
             home screen to be scanned. In a task of its own, so a share
             never brings back the home screen's task instead of a sheet. -->
        <activity
            android:name=".ShareActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:launchMode="singleInstance"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@style/Theme.Rift.Sheet">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>

        <!-- The core's interface for the browser app (§8.3): navigation
             decisions and session requests only, no file operations. Exported under the signature permission, and every
             call checks the browser app's UID and signer. -->
        <service
            android:name=".CoreService"
            android:exported="true"
            android:permission="org.simulationrift.permission.RIFT" />

        <!-- The network lock (§8.8): a VPN for the browser app only, which
             forwards nothing. -->
        <service
            android:name=".NetworkLockService"
            android:exported="false"
            android:permission="android.permission.BIND_VPN_SERVICE">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
        </service>

        <!-- Extra isolation (§8.9): how Shizuku or Sui hands Rift its binder.
             Only the system, shell and root hold INTERACT_ACROSS_USERS_FULL,
             so no app can call it. -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:enabled="true"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

        <!-- Untrusted-input worker (§8.6): random isolated UID, isolated_app
             domain, no permissions, no app files. Forked from the app zygote,
             one instance per preview. -->
        <service
            android:name=".PreviewService"
            android:exported="false"
            android:isolatedProcess="true"
            android:useAppZygote="true" />
    </application>
</manifest>
