<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The only permission (§8.2). Camera, microphone, location, storage and
         the rest are absent, so the OS denies them whatever a page asks. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.NoActionBar">

        <!-- Privacy defaults (INV-11): no WebView usage metrics, and Safe
             Browsing (which sends URL hash prefixes to Google) stays off until
             the user opts in. -->
        <meta-data
            android:name="android.webkit.WebView.MetricsOptOut"
            android:value="true" />
        <meta-data
            android:name="android.webkit.WebView.EnableSafeBrowsing"
            android:value="false" />

        <!-- Trusted controller: UI, rift-core, sessions. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Rift appears as a browser choice; the link is checked before loading. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="http" />
                <data android:scheme="https" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- Browser host (§8.3): its own process so that killing it and deleting
             its data directory disposes of a session. Same UID as the app, so
             it is a lifecycle boundary, not a security identity. -->
        <activity
            android:name=".BrowserActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode"
            android:exported="false"
            android:launchMode="singleTask"
            android:process=":browser" />

        <!-- The core's interface for :browser: navigation decisions and session
             requests only. No vault or export operations (§8.3 c). -->
        <service
            android:name=".CoreService"
            android:exported="false" />
    </application>
</manifest>
