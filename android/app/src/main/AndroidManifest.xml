<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The only permission (§8.2), for rift-core's own transfers and the
         egress proxy. Camera, microphone, location, storage and the rest are
         absent from both apps, so the OS denies them whatever a page asks. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- The browser app must be visible to bind and start it (API 30). -->
    <queries>
        <package android:name="org.simulationrift.browser" />
    </queries>

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.NoActionBar"
        android:zygotePreloadName=".PreviewZygotePreload">

        <!-- Trusted controller: UI, rift-core, sessions. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Rift appears as a browser choice; the link is checked before loading. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="http" />
                <data android:scheme="https" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- The core's interface for the browser app (§8.3): navigation
             decisions and session requests only, no vault, file or export
             operations. Exported under the signature permission, and every
             call checks the browser app's UID and signer. -->
        <service
            android:name=".CoreService"
            android:exported="true"
            android:permission="org.simulationrift.permission.RIFT" />

        <!-- The network lock (§8.8): a VPN for the browser app only, which
             forwards nothing. -->
        <service
            android:name=".NetworkLockService"
            android:exported="false"
            android:permission="android.permission.BIND_VPN_SERVICE">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
        </service>

        <!-- Untrusted-input worker (§8.6): random isolated UID, isolated_app
             domain, no permissions, no app files. Forked from the app zygote,
             one instance per preview. -->
        <service
            android:name=".PreviewService"
            android:exported="false"
            android:isolatedProcess="true"
            android:useAppZygote="true" />
    </application>
</manifest>
