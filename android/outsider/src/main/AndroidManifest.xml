<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Asks for Rift's permission like any app could; a signature
         permission is never granted to a different signer. -->
    <uses-permission android:name="org.simulationrift.permission.RIFT" />
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- h3: "display over other apps", which the test grants through appops. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <queries>
        <package android:name="org.simulationrift.app" />
        <package android:name="org.simulationrift.browser" />
    </queries>

    <application android:allowBackup="false" android:label="Rift outsider (test)">
        <activity
            android:name=".OutsiderActivity"
            android:exported="true" />

        <!-- S28: another VPN app starting, which revokes Rift's network lock.
             It routes only this app's own traffic. -->
        <service
            android:name=".OutsiderVpn"
            android:exported="false"
            android:permission="android.permission.BIND_VPN_SERVICE">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
        </service>

        <!-- h3: an overlay over every app. -->
        <service
            android:name=".OutsiderOverlay"
            android:exported="false" />

        <!-- h3: an autofill service, enabled by the test. -->
        <service
            android:name=".OutsiderAutofill"
            android:exported="true"
            android:permission="android.permission.BIND_AUTOFILL_SERVICE">
            <intent-filter>
                <action android:name="android.service.autofill.AutofillService" />
            </intent-filter>
        </service>

        <!-- h4: an accessibility service that is not a tool, enabled by the host step. -->
        <service
            android:name=".OutsiderAccessibility"
            android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility" />
        </service>
    </application>
</manifest>
