<?xml version="1.0" encoding="utf-8"?>
<!-- Rift's launcher icon, foreground layer: a shield split by a rift.
     Scaled so the shield stays inside the 66 dp safe circle of any mask. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
  <group android:pivotX="54" android:pivotY="54" android:scaleX="0.7" android:scaleY="0.7">
    <path android:pathData="M54,17L83,27V51C83,70 70.5,84 54,91C37.5,84 25,70 25,51V27Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="25"
                android:startY="17"
                android:endX="83"
                android:endY="91"
                android:startColor="#FFFFFFFF"
                android:endColor="#FFDCD3FF" />
        </aapt:attr>
    </path>
    <!-- The rift: a dark gap with a glowing core, cut only into the shield. -->
    <group>
        <clip-path android:pathData="M54,17L83,27V51C83,70 70.5,84 54,91C37.5,84 25,70 25,51V27Z" />
        <path
            android:strokeColor="#FF2A1C70"
            android:strokeWidth="9"
            android:strokeLineJoin="miter"
            android:pathData="M57,15L48,40L60,52L50,93" />
        <path
            android:strokeWidth="3.5"
            android:strokeLineJoin="miter"
            android:pathData="M57,15L48,40L60,52L50,93">
            <aapt:attr name="android:strokeColor">
                <gradient
                    android:type="linear"
                    android:startX="54"
                    android:startY="17"
                    android:endX="54"
                    android:endY="91"
                    android:startColor="#FF7DF9E4"
                    android:endColor="#FF38BDF8" />
            </aapt:attr>
        </path>
    </group>
  </group>
</vector>
